# Шаблон окружения. Скопируйте в .env и заполните. Секреты в репозиторий не коммитим.

# --- Адрес приложения --------------------------------------------------------
# Абсолютный https-адрес, на котором доступен сервер. Из него строятся обработчики встройки
# (/invoice) и событий (/api/b24/events). Без него страница установки возьмёт адрес из браузера.
NUXT_PUBLIC_SITE_URL=https://invoice.example.com

# --- Приложение в Битрикс24 ----------------------------------------------------
# Реквизиты из карточки локального приложения (или из кабинета разработчика Маркета).
# Нужны, чтобы сверить установку (member_id) и обновлять токен установщика.
# Без них сервер НЕ сохранит установку (fail-closed, docs/B24_EVENTS.md).
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Код приложения (app.info → CODE; пока переменная не задана, его показывает администратору главная
# страница приложения). ОБЯЗАТЕЛЕН: без него сервер отвечает 503 на все запросы из фрейма —
# BitrixGPT, сохранение настроек и ставок.
B24_APP_CODE=
# application_token. Не обязателен: без него первый ONAPPINSTALL задаёт токен портала.
B24_APPLICATION_TOKEN=
# Коробочные порталы (не *.bitrix24.*), через запятую: crm.company.by, portal.local — для SSRF-гарда.
# ⚠ Установка из коробки не сохраняется: приложение облачное, коробку сервером авторизации не принимаем.
B24_SELFHOSTED_HOSTS=

# --- Шифрование токенов ---------------------------------------------------------
# 32 байта hex (64 символа) или base64. Сгенерировать: openssl rand -hex 32
# Шифрует оба токена установки (access и refresh). Храните копию ключа вне сервера: потеря или смена
# ключа делает сохранённые токены нечитаемыми — порталам придётся переустановить приложение.
B24_TOKEN_ENC_KEY=

# --- Сеть ------------------------------------------------------------------------
# 1 — сервер стоит за СВОИМ обратным прокси (nginx, Caddy, Traefik), который дописывает адрес клиента
# в X-Forwarded-For. Тогда лимиты частоты считаются по настоящему IP клиента, иначе все запросы
# выглядят пришедшими с адреса прокси и лимиты становятся общими. Заголовку верим только от
# соединений из частной сети (прокси, мост Docker). Рассчитано на один прокси перед сервером.
TRUST_PROXY=

# --- BitrixGPT (Bitrix Vibecode AI Router) --------------------------------------------
# Ключ Вайбкода (vibe_…). BITRIXGPT_API_KEY приоритетнее VIBE_API_KEY.
VIBE_API_KEY=
# BITRIXGPT_API_KEY=
# BITRIXGPT_BASE_URL=https://vibecode.bitrix24.tech/v1
# BITRIXGPT_MODEL=bitrix/bitrixgpt-5.5
