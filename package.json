    "@vueuse/nuxt": "^14.4.0",
    "markdown-it": "^14.3.2",
    "nuxt": "^4.6.2",
    "openai": "^7.3.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@types/markdown-it": "^14.2.0",
