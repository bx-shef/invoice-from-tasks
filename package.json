    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
